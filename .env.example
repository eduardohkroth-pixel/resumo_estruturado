# Copie este arquivo para ".env" e preencha os valores.
# NUNCA versione o arquivo .env com a chave real.

# Chave da API da Anthropic (obrigatória). Obtenha em https://console.anthropic.com
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Modelo a usar (opcional). Padrão: claude-sonnet-5
# Outras opções: claude-opus-5, claude-opus-4-8, claude-haiku-4-5
# Verifique os IDs atuais em https://docs.claude.com/en/docs/about-claude/models
MODEL=claude-sonnet-5

# Máximo de tokens de saída (opcional). Padrão: 8000
MAX_TOKENS=8000

# Porta do servidor (opcional). Padrão: 3000
PORT=3000
